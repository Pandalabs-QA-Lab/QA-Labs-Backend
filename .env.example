DATABASE_URL=postgresql://postgres:<password>@localhost:5432/qalab?schema=public
JWT_SECRET=<random 64-byte hex, e.g. via `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`>
JWT_EXPIRES_IN=7d
PORT=4000
# Comma-separated list of allowed origins, e.g. http://localhost:5173,https://app.example.com
# Use * to allow every origin.
CORS_ORIGIN=http://localhost:5173
# Production: use an absolute path on a persistent volume outside the checkout.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Invitation email. Set APP_PUBLIC_URL to the frontend URL (including its base path).
APP_PUBLIC_URL=http://localhost:5173/QA-Labs-Frontend/
# Zoho free organization example; use the hostname for your account's region.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=QA Lab <hello@example.com>
SMTP_USER=primary-mailbox@example.com
# Application password for the primary mailbox when MFA is enabled.
SMTP_PASSWORD=
